# Copy to ~/.config/thyra/thyra.env and set permissions to 0600.
HOST=0.0.0.0
PORT=8787

# Optional fixed password. By default, service install creates a generated token.
# THYRA_PASSWORD=replace-with-a-strong-password

# Operational logs default to info. Use debug only while diagnosing an issue.
# THYRA_LOG_LEVEL=info

# Optional: use a custom HTTPS flat release mirror for checks and installs.
# Mirror the platform archive, .sha256, and .update.json assets together.
# THYRA_UPDATE_BASE_URL=https://releases.example.com/thyra

# Optional Herdr connection settings.
# HERDR_SOCKET_PATH=/path/to/herdr.sock
# HERDR_CLIENT_SOCKET_PATH=/path/to/herdr-client.sock
# HERDR_SSH_HOST=user@example.com

# Optional public listener for Cloudflare Tunnel; see
# docs/DEPLOYMENT.md#public-access-through-cloudflare-tunnel.
# THYRA_PUBLIC_LISTEN=127.0.0.1:8788
# THYRA_PUBLIC_ORIGIN=https://thyra.example.com
