[Unit]
Description=Thyra
Documentation=https://github.com/Yubo-Cao/thyra
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/thyra/thyra.env
ExecStart=%h/.local/bin/thyra
Restart=always
RestartSec=2
TimeoutStopSec=15

[Install]
WantedBy=default.target
