[Unit]
Description=Thyra
Documentation=https://github.com/Yubo-Cao/thyra
Wants=network-online.target
After=network-online.target
# A crash loop stops after 10 starts in 5 minutes instead of retrying forever.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
EnvironmentFile=-%h/.config/thyra/thyra.env
# Sign-in provider secrets (Resend, GitHub, Google), mode 0600.
EnvironmentFile=-%h/.config/thyra/auth-providers.env
ExecStart=%h/.local/bin/thyra
Restart=always
RestartSec=2
# Startup failures that need the operator, such as an account database
# that does not migrate, exit 78 and are not restarted.
RestartPreventExitStatus=78
TimeoutStopSec=15

[Install]
WantedBy=default.target
